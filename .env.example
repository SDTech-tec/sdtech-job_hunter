# ============================================================
# SDTech Soluctions — Environment Variables
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no Git.
# ============================================================

# ------------------------------------------------------------
# AMBIENTE
# ------------------------------------------------------------
# Valores: development | staging | production
APP_ENV=development

# ------------------------------------------------------------
# POSTGRESQL — CONEXÃO PRINCIPAL (aplicação)
# ------------------------------------------------------------
# Usuário de aplicação com privilégios mínimos (NÃO use postgres)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=sdtech_soluctions
DB_USER=sdtech_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DB_SSLMODE=disable

# URL completa (alternativa)
DATABASE_URL=postgres://sdtech_app:CHANGE_ME_APP_PASSWORD@localhost:5434/sdtech_soluctions?sslmode=disable

# ------------------------------------------------------------
# POSTGRESQL — CONEXÃO ADMINISTRATIVA (migrations/setup)
# ------------------------------------------------------------
# Usuário com permissão para criar banco e usuários
DB_ADMIN_USER=sdtech_owner
DB_ADMIN_PASSWORD=CHANGE_ME_OWNER_PASSWORD
DB_ADMIN_URL=postgres://sdtech_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5434/sdtech_soluctions?sslmode=disable

# ------------------------------------------------------------
# POSTGRESQL — PRODUÇÃO (VPS Oracle)
# ------------------------------------------------------------
# Descomente e preencha apenas em produção/staging
# DB_HOST=postgres
# DB_PORT=5432
# DB_SSLMODE=require

# ------------------------------------------------------------
# REDIS (para uso futuro)
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# ------------------------------------------------------------
# n8n WEBHOOK
# ------------------------------------------------------------
N8N_WEBHOOK_URL=http://n8n:5678/webhook/sdtech-soluctions

# ------------------------------------------------------------
# EVOLUTION API
# ------------------------------------------------------------
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY

# ------------------------------------------------------------
# BACKUP
# ------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
